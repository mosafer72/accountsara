<configuration>
	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<pages controlRenderingCompatibilityVersion="4.0" />
	</system.web>

	<system.webServer>
		<staticContent>
			<!-- MIME type برای تصاویر webp -->
			<mimeMap fileExtension=".webp" mimeType="image/webp" />
		</staticContent>
	</system.webServer>
</configuration>

